---
import { Users, Clock, GraduationCap } from '@lucide/astro';
import type { Program } from '@bee-champs/shared';
import AddToPlannerButton from './planner/AddToPlannerButton.svelte';

interface Props {
  program: Program;
  color: string;
  categoryLabel: string;
}

const { program, color, categoryLabel } = Astro.props;
---

<div class="bg-bg-primary rounded-xl border border-border-primary flex flex-col h-full hover:-translate-y-1 hover:shadow-[0_8px_20px_rgba(236,140,17,0.15)] transition-all duration-300 overflow-hidden honey-glow">
  {/* Horní část s barevným gradientem a ikonou */}
  <div
    class="h-24 flex items-center justify-center text-5xl relative"
    style={`background: linear-gradient(135deg, ${color}15, ${color}08);`}
  >
    {program.icon}
    {/* Honey top border */}
    <div class="absolute top-0 left-0 right-0 h-1" style={`background: ${color};`}></div>
  </div>

  {/* Obsah karty */}
  <div class="p-6 flex flex-col grow">
    {/* Badge kategorie */}
    <div class="mb-3">
      <span
        class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide"
        style={`background-color: ${color}15; color: ${color};`}
      >
        {categoryLabel}
      </span>
    </div>

    {/* Název */}
    <h3 class="text-xl font-bold font-heading text-white mb-2">
      {program.name}
    </h3>

    {/* Popis */}
    <p class="text-text-secondary text-sm mb-6 grow">
      {program.description}
    </p>

    {/* Metadata */}
    <div class="space-y-2 mb-6 pt-4 border-t border-border-primary">
      <div class="flex items-center text-sm text-text-secondary">
        <GraduationCap class="w-4 h-4 mr-3 text-primary/60" />
        <span class="font-medium text-white/80">Věk:</span>
        <span class="ml-1">{program.ageRange}</span>
      </div>
      <div class="flex items-center text-sm text-text-secondary">
        <Clock class="w-4 h-4 mr-3 text-primary/60" />
        <span class="font-medium text-white/80">Délka:</span>
        <span class="ml-1">{program.duration}</span>
      </div>
      <div class="flex items-center text-sm text-text-secondary">
        <Users class="w-4 h-4 mr-3 text-primary/60" />
        <span class="font-medium text-white/80">Lektoři:</span>
        <span class="ml-1">{program.instructors}</span>
      </div>
    </div>

    {/* Přidat do plánovače */}
    <AddToPlannerButton programId={program.id} color={color} client:load />
  </div>
</div>
