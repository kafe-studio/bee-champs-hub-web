---
import { CalendarRange } from '@lucide/astro';
import { t } from '@i18n';

interface Props {
  settings?: Record<string, string>;
}

const { settings = {} } = Astro.props;

const stat1Value = settings.stat1_value ?? t.hero.stat1Value;
const stat1Label = settings.stat1_label ?? t.hero.stat1Label;
const stat2Value = settings.stat2_value ?? t.hero.stat2Value;
const stat2Label = settings.stat2_label ?? t.hero.stat2Label;
const stat3Value = settings.stat3_value ?? t.hero.stat3Value;
const stat3Label = settings.stat3_label ?? t.hero.stat3Label;
---

<section class="relative min-h-[85vh] flex items-center overflow-hidden bg-bg-primary">
  <!-- Pozadí — obrázek s tmavým gradientem -->
  <div class="absolute inset-0">
    <img
      src="/images/hero.avif"
      alt=""
      class="w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[rgba(17,17,17,0.92)] via-[rgba(17,17,17,0.6)] to-[rgba(236,140,17,0.1)]"></div>
  </div>

  <!-- Honeycomb dekorativní pattern -->
  <div class="absolute inset-0 honeycomb-bg opacity-30 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-20">
    <div class="max-w-2xl fade-up">
      <h1 class="text-4xl sm:text-5xl lg:text-[4rem] font-heading font-bold mb-6 leading-[1.05] text-white uppercase">
        {t.hero.title}<br />
        <span class="text-primary">{t.hero.titleHighlight}</span>
      </h1>

      <!-- Bullet pointy pod nadpisem -->
      <ul class="space-y-2 mb-10">
        <li class="flex items-center gap-3 text-white/80 text-lg">
          <span class="w-2 h-2 bg-primary rounded-full shrink-0"></span>
          Všestranný sportovní program
        </li>
        <li class="flex items-center gap-3 text-white/80 text-lg">
          <span class="w-2 h-2 bg-primary rounded-full shrink-0"></span>
          Motivace a inspirace
        </li>
        <li class="flex items-center gap-3 text-white/80 text-lg">
          <span class="w-2 h-2 bg-primary rounded-full shrink-0"></span>
          Individuální přístup
        </li>
      </ul>

      <!-- CTA tlačítka — skosený styl -->
      <div class="flex flex-wrap gap-4">
        <a
          href="/planovac"
          class="btn-skew bg-primary hover:bg-primary-hover text-bg-primary px-10 py-4 font-bold text-lg inline-flex items-center gap-2 transition-all"
        >
          <CalendarRange class="w-5 h-5" />
          {t.hero.openPlanner}
        </a>
        <a
          href="#kategorie"
          class="btn-skew bg-white/10 hover:bg-white/20 text-white border border-white/20 px-10 py-4 font-bold text-lg transition-all"
        >
          {t.common.browsePrograms}
        </a>
      </div>

      <!-- Statistiky -->
      <div class="mt-14 flex gap-8 sm:gap-12">
        <div>
          <h4 class="text-3xl font-heading font-bold text-primary mb-1">{stat1Value}</h4>
          <p class="text-white/50 text-sm uppercase tracking-wider">{stat1Label}</p>
        </div>
        <div>
          <h4 class="text-3xl font-heading font-bold text-primary mb-1">{stat2Value}</h4>
          <p class="text-white/50 text-sm uppercase tracking-wider">{stat2Label}</p>
        </div>
        <div>
          <h4 class="text-3xl font-heading font-bold text-primary mb-1">{stat3Value}</h4>
          <p class="text-white/50 text-sm uppercase tracking-wider">{stat3Label}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/40 z-10">
    <span class="text-xs uppercase tracking-[0.2em]">scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-primary to-transparent"></div>
  </div>
</section>
