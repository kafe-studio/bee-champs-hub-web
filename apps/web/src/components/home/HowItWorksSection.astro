---
import { CalendarRange, CircleCheckBig, Send, Trophy } from '@lucide/astro';

const steps = [
  {
    number: "01",
    Icon: CalendarRange,
    title: "Otevřete plánovač",
    description: "V ročním plánovači vidíte celou nabídku — sport, vzdělávání i pobyty — přehledně na jednom místě.",
  },
  {
    number: "02",
    Icon: CircleCheckBig,
    title: "Vyberte programy",
    description: "Klikejte a přidávejte klidně 10 různých akcí. Každou přiřaďte do měsíce podle potřeby.",
  },
  {
    number: "03",
    Icon: Send,
    title: "Odešlete poptávku",
    description: "Jeden formulář, všechny akce najednou. Kontakt, počty dětí, termíny — hotovo za 2 minuty.",
  },
  {
    number: "04",
    Icon: Trophy,
    title: "My zařídíme vše",
    description: "Potvrdíme detaily a zajistíme realizaci každé akce přesně podle vašeho plánu.",
  },
];
---

<section class="bg-bg-secondary py-20 relative overflow-hidden">
  <!-- Dekorativní honey gradient nahoře -->
  <div class="absolute top-0 left-0 right-0 honey-divider"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-12 fade-up">
      <span class="text-primary font-semibold text-sm uppercase tracking-[0.2em]">Jak to funguje</span>
      <h2 class="text-3xl md:text-4xl font-bold text-white mt-2 mb-4 font-heading uppercase">
        Od výběru k realizaci
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 fade-up">
      {steps.map((step) => (
        <div class="relative bg-bg-primary rounded-xl p-6 border border-border-primary overflow-hidden honey-glow hover:honey-glow-strong transition-all duration-400">
          {/* Velké číslo v pozadí */}
          <div class="absolute top-2 right-4 text-7xl font-bold text-primary/10 font-heading select-none">
            {step.number}
          </div>

          {/* Hexagonální ikona */}
          <div class="w-14 h-14 hex-clip bg-primary/15 flex items-center justify-center mb-4 relative z-10">
            <step.Icon class="w-6 h-6 text-primary" />
          </div>

          <h3 class="text-lg font-bold text-white mb-2 font-heading relative z-10">
            {step.title}
          </h3>
          <p class="text-text-secondary text-sm relative z-10">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>

  {/* Honey divider dole */}
  <div class="absolute bottom-0 left-0 right-0 honey-divider"></div>
</section>
