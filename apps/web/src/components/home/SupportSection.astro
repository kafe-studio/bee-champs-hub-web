---
/**
 * Sekce "Za podpory" — odkaz na FTVS UK
 */
---

<section class="bg-bg-primary py-12">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <a
      href="https://www.ftvs.cuni.cz/cs"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block transition-opacity hover:opacity-80"
    >
      <img
        src="/images/ftvs-podpory.jpg"
        alt="Za podpory Univerzity Karlovy — Fakulta tělesné výchovy a sportu"
        class="max-w-xs sm:max-w-sm mx-auto rounded-lg"
        width="400"
        height="283"
        loading="lazy"
      />
    </a>
  </div>
</section>
